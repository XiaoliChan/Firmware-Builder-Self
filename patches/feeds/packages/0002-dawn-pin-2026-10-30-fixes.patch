+++ b/net/dawn/Makefile
@@ -5,13 +5,13 @@
 include $(TOPDIR)/rules.mk

 PKG_NAME:=dawn
-PKG_SOURCE_DATE:=2026-06-10
+PKG_SOURCE_DATE:=2026-10-30
 PKG_RELEASE:=1

 PKG_SOURCE_PROTO:=git
