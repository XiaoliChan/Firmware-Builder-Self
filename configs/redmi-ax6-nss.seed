#
# Redmi AX6 (IPQ8071A, 512MB) — openwrt-nss-edma NSS 硬件加速固件
#
# seed:scripts/prepare-build.sh 复制为 .config 后跑 make defconfig。
# NSS 栈与工具链选项取自 Qualcommax_NSS_Builder 的 devices/common/config
# (同平台 AX3600 验证过),用户自选包提炼自旧 qosmio main-nss config。
#

## Target:单设备,sysupgrade-only(无 factory/initramfs)
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

## 512MB 内存档(ath11k 与 NSS 的编译期档位)
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

## 工具链优化(Builder 同款:GCC15 + LTO + MOLD)
CONFIG_BINUTILS_USE_VERSION_2_46=y
CONFIG_DEVEL=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"
CONFIG_TARGET_OPTIONS=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y
# CONFIG_CCACHE is not set

## 内核与加固(Builder 同款)
CONFIG_BUILD_PATENTED=y
CONFIG_EXPERIMENTAL=y
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

## NSS 数据面 + 连接卸载(ECM/PPPoE/桥转发/组播)
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y

## ath11k NSS 无线卸载(wifili)
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
# CONFIG_ATH11K_DEBUGFS_HTT_STATS is not set
CONFIG_ATH11K_DEBUGFS_STA=y

## NSS qdisc/SQM + 运行时工具 + QoS 标记
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_nss-tools=y
CONFIG_PACKAGE_luci-app-nss=y
CONFIG_PACKAGE_nssqos=y
CONFIG_PACKAGE_luci-app-nssqos=y

## NSS 诊断:镜像抓包 + 实时统计(edma-dump 需要 devmem)
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

## 崩溃取证:重启后把内核日志归档到 /root/pstore
CONFIG_PACKAGE_kmod-ramoops=y

## SSL/apk(openwrt main 系是 apk 包管理)
CONFIG_LUA_ECO_MBEDTLS=n
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
# CONFIG_PACKAGE_apk-mbedtls is not set
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-oqsprovider=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y

## 用户自选(旧 qosmio config 挖掘:无线认证 + 802.11k/v + 监控)
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_luci-app-dawn=y
CONFIG_PACKAGE_dawn=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-iwinfo=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-rrdtool=y

## 用户自选(运维工具,旧 config 原有)
CONFIG_PACKAGE_curl=y
CONFIG_LIBCURL_MBEDTLS=n
CONFIG_LIBCURL_OPENSSL=y
CONFIG_PACKAGE_htop=y
CONFIG_HTOP_LMSENSORS=n
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
